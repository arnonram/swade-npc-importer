{
  "name": "swade-npc-importer",
  "version": "0.2.0",
  "description": "Import stat blocks for SWADE",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c --configPlugin @rollup/plugin-typescript",
    "build:watch": "yarn clean && rollup -cw --configPlugin @rollup/plugin-typescript",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Arnon Ram",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@guanghechen/rollup-plugin-copy": "^6.0.7",
    "@playwright/test": "^1.46.1",
    "@rollup/plugin-typescript": "^12.1.3",
    "@types/fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.30.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.2.2",
    "rollup": "^4.44.0",
    "rollup-plugin-livereload": "^2.0.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnonram/swade-npc-importer.git"
  },
  "bugs": {
    "url": "https://github.com/arnonram/swade-npc-importer/issues"
  },
  "homepage": "https://github.com/arnonram/swade-npc-importer#readme"
}
