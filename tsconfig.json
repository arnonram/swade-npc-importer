{
  "compilerOptions": {
    "types": ["@types/fvtt-types"],
    "outDir": "dist",
    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "esnext",
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  }
}
