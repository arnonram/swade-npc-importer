<div class='standard-form' style='flex: 1; min-height: 0'>
  <div class='standard-form scrollable' style='flex: 1; min-height: 0'>
    <fieldset>
      <legend>{{localize 'npcImporter.settings.SelectPacks'}}</legend>
      <p class='hint'>{{localize 'npcImporter.settings.SelectPacksInfo'}}</p>
      {{#each packs}}
        <label class='checkbox'>
          <input type='checkbox' name='pack.{{this.name}}' {{this.checked}} />
          {{this.name}}
        </label>
      {{/each}}
    </fieldset>
    <fieldset>
      <legend>{{localize 'npcImporter.settings.SelectCompendiums'}}</legend>
      {{#each comps}}
        <label class='checkbox'>
          <input type='checkbox' name='comp.{{this.name}}' {{this.checked}} />
          {{this.name}}
        </label>
      {{/each}}
    </fieldset>
  </div>
  <footer class='form-footer'>
    <button type='submit'>
      <i class='fa-solid fa-floppy-disk'></i>
      {{localize 'npcImporter.HTML.Save'}}
    </button>
  </footer>
</div>