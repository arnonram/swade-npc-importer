<div class='standard-form'>
  <p class='hint'>{{importDesc}}</p>

  <!-- Statblock -->
  <div class='form-group stacked'>
    <label for='statBlock'>{{statBlockLabel}}</label>
    <textarea id='statBlock' name='statBlock' rows='12' autofocus></textarea>
  </div>

  <fieldset>
    <legend>{{localize 'DOCUMENT.Actor'}}</legend>
    <div class='form-group'>
      <label>{{actorTypeLabel}}</label>
      <div class='form-fields'>
        <label class='checkbox'>
          <input
            type='radio'
            name='actorType'
            value='npc'
            {{isChecked actorType 'npc'}}
          />
          {{npcLabel}}
        </label>
        <label class='checkbox'>
          <input
            type='radio'
            name='actorType'
            value='character'
            {{isChecked actorType 'character'}}
          />
          {{characterLabel}}
        </label>
      </div>
    </div>
    <div class='form-group'>
      <label for='swade-stat-imp-isWildCard'>{{wildcardLabel}}</label>
      <div class='form-fields'>
        <input
          type='checkbox'
          id='swade-stat-imp-isWildCard'
          name='isWildcard'
          value='true'
          {{isChecked isWildcard true}}
        />
      </div>
    </div>
    <div class='form-group'>
      <label for='swade-stat-imp-save-folder'>{{saveFolderLabel}}</label>
      <div class='form-fields'>
        <select id='swade-stat-imp-save-folder' name='save-folder'>
          {{{folderOptions}}}
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize 'DOCUMENT.Token'}}</legend>
    <div class='form-group'>
      <label for='swade-stat-imp-disposition'>{{dispositionLabel}}</label>
      <div class='form-fields'>
        <select id='swade-stat-imp-disposition' name='disposition'>
          <option value='-1' {{isSelected disposition -1}}>
            {{hostileLabel}}
          </option>
          <option value='0' {{isSelected disposition 0}}>
            {{neutralLabel}}
          </option>
          <option value='1' {{isSelected disposition 1}}>
            {{friendlyLabel}}
          </option>
          <option value='-2' {{isSelected disposition -2}}>
            {{secretLabel}}
          </option>
        </select>
      </div>
    </div>
    <div class='form-group'>
      <label for='swade-stat-imp-vision'>{{sightEnabledLabel}}</label>
      <div class='form-fields'>
        <input
          type='checkbox'
          id='swade-stat-imp-vision'
          name='vision'
          {{isChecked vision true}}
        />
      </div>
    </div>
    <div class='form-group'>
      <label for='swade-stat-imp-visionRange'>{{sightRangeLabel}}</label>
      <div class='form-fields'>
        <input
          type='number'
          id='swade-stat-imp-visionRange'
          name='visionRange'
          step='1'
          value='{{visionRange}}'
        />
      </div>
    </div>
    <div class='form-group'>
      <label for='swade-stat-imp-visionAngle'>{{sightAngleLabel}}</label>
      <div class='form-fields'>
        <input
          type='number'
          id='swade-stat-imp-visionAngle'
          name='visionAngle'
          step='1'
          min='0'
          max='360'
          value='{{visionAngle}}'
        />
      </div>
    </div>
  </fieldset>
</div>